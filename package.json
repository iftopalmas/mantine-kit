{
    "name": "@ifto/mantine-kit",
    "version": "0.0.0",
    "description": "General purpose Mantine components for React apps: CRUD tables and forms, layout, ECharts charts, Excel/CSV export, print pages and a REST HTTP client, with i18n (en-US and pt-BR).",
    "license": "MIT",
    "author": "IFTO - Campus Palmas",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/iftopalmas/mantine-kit.git"
    },
    "homepage": "https://github.com/iftopalmas/mantine-kit#readme",
    "bugs": "https://github.com/iftopalmas/mantine-kit/issues",
    "keywords": [
        "i18n",
        "mantine",
        "react",
        "components",
        "crud",
        "datatable",
        "echarts",
        "excel",
        "csv"
    ],
    "packageManager": "yarn@4.18.1",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        "./styles.css": "./dist/styles.css",
        "./print.css": "./dist/styles/print.css",
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/print.css dist/styles/",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src __test__ test-utils && yarn lint:stylelint",
        "lint:stylelint": "stylelint 'src/**/*.css' --cache",
        "jest": "jest",
        "jest:watch": "jest --watch",
        "prettier:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json}\"",
        "prettier:write": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json}\"",
        "test": "yarn prettier:check && yarn lint && yarn typecheck && yarn jest --coverage"
    },
    "peerDependencies": {
        "@mantine/core": "^9.7.1",
        "@mantine/dates": "^9.7.1",
        "@mantine/form": "^9.7.1",
        "@mantine/hooks": "^9.7.1",
        "@mantine/modals": "^9.7.1",
        "@mantine/notifications": "^9.7.1",
        "@tabler/icons-react": "^3.24.0",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.13",
        "echarts": "^6.1.0",
        "exceljs": "^4.4.0",
        "mantine-datatable": "^9.4.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "zod": "^4.6.6"
    },
    "peerDependenciesMeta": {
        "axios": {
            "optional": true
        },
        "echarts": {
            "optional": true
        },
        "exceljs": {
            "optional": true
        },
        "mantine-datatable": {
            "optional": true
        },
        "zod": {
            "optional": true
        }
    },
    "devDependencies": {
        "@mantine/core": "9.7.1",
        "@mantine/dates": "9.7.1",
        "@mantine/form": "9.7.1",
        "@mantine/hooks": "9.7.1",
        "@mantine/modals": "9.7.1",
        "@mantine/notifications": "9.7.1",
        "@swc/core": "^1.16.20",
        "@swc/jest": "^0.2.39",
        "@tabler/icons-react": "^3.24.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.10.1",
        "@types/react": "19.2.0",
        "@types/react-dom": "19.2.0",
        "@typescript-eslint/parser": "^8.72.1",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.13",
        "echarts": "^6.1.0",
        "eslint": "^9.16.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.1.0",
        "exceljs": "4.4.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "magic-string": "^1.4.5",
        "mantine-datatable": "^9.4.0",
        "postcss": "^8.5.29",
        "postcss-preset-mantine": "1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.4.2",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "stylelint": "^16.11.0",
        "stylelint-config-standard-scss": "^14.0.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "zod": "^4.6.6"
    }
}
